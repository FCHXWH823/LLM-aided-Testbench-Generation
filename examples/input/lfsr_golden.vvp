#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x55e1b33c4110 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x55e1b33cc160 .scope module, "tb_lfsr_4bit_golden" "tb_lfsr_4bit_golden" 3 4;
 .timescale 0 0;
v0x55e1b33f6e80_0 .var "clk", 0 0;
v0x55e1b33f6f40_0 .var "en", 0 0;
v0x55e1b33f7010_0 .var/i "failed", 31 0;
v0x55e1b33f70e0_0 .var/i "i", 31 0;
v0x55e1b33f71a0_0 .net "lfsr_out", 3 0, v0x55e1b33f6c60_0;  1 drivers
v0x55e1b33f72b0_0 .var/i "passed", 31 0;
v0x55e1b33f7370_0 .var "reset_n", 0 0;
S_0x55e1b33cc2f0 .scope module, "dut" "lfsr_4bit" 3 16, 4 1 0, S_0x55e1b33cc160;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset_n";
    .port_info 2 /INPUT 1 "en";
    .port_info 3 /OUTPUT 4 "lfsr_out";
L_0x55e1b33f7600 .functor XOR 1, L_0x55e1b33f7440, L_0x55e1b33f7560, C4<0>, C4<0>;
v0x55e1b33cc510_0 .net *"_ivl_1", 0 0, L_0x55e1b33f7440;  1 drivers
v0x55e1b33f6910_0 .net *"_ivl_3", 0 0, L_0x55e1b33f7560;  1 drivers
v0x55e1b33f69f0_0 .net "clk", 0 0, v0x55e1b33f6e80_0;  1 drivers
v0x55e1b33f6a90_0 .net "en", 0 0, v0x55e1b33f6f40_0;  1 drivers
v0x55e1b33f6b50_0 .net "feedback", 0 0, L_0x55e1b33f7600;  1 drivers
v0x55e1b33f6c60_0 .var "lfsr_out", 3 0;
v0x55e1b33f6d40_0 .net "reset_n", 0 0, v0x55e1b33f7370_0;  1 drivers
E_0x55e1b3391d60/0 .event negedge, v0x55e1b33f6d40_0;
E_0x55e1b3391d60/1 .event posedge, v0x55e1b33f69f0_0;
E_0x55e1b3391d60 .event/or E_0x55e1b3391d60/0, E_0x55e1b3391d60/1;
L_0x55e1b33f7440 .part v0x55e1b33f6c60_0, 3, 1;
L_0x55e1b33f7560 .part v0x55e1b33f6c60_0, 0, 1;
    .scope S_0x55e1b33cc2f0;
T_0 ;
    %wait E_0x55e1b3391d60;
    %load/vec4 v0x55e1b33f6d40_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 8, 0, 4;
    %assign/vec4 v0x55e1b33f6c60_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x55e1b33f6a90_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x55e1b33f6b50_0;
    %load/vec4 v0x55e1b33f6c60_0;
    %parti/s 3, 1, 2;
    %concat/vec4; draw_concat_vec4
    %assign/vec4 v0x55e1b33f6c60_0, 0;
T_0.2 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x55e1b33cc160;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x55e1b33f72b0_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x55e1b33f7010_0, 0, 32;
    %end;
    .thread T_1, $init;
    .scope S_0x55e1b33cc160;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55e1b33f6e80_0, 0, 1;
T_2.0 ;
    %delay 5, 0;
    %load/vec4 v0x55e1b33f6e80_0;
    %inv;
    %store/vec4 v0x55e1b33f6e80_0, 0, 1;
    %jmp T_2.0;
    %end;
    .thread T_2;
    .scope S_0x55e1b33cc160;
T_3 ;
    %vpi_call/w 3 31 "$display", "========================================" {0 0 0};
    %vpi_call/w 3 32 "$display", "Starting LFSR Golden Testbench" {0 0 0};
    %vpi_call/w 3 33 "$display", "========================================" {0 0 0};
    %vpi_call/w 3 36 "$display", "\012Test 1: Reset Functionality" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55e1b33f7370_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55e1b33f6f40_0, 0, 1;
    %delay 20, 0;
    %load/vec4 v0x55e1b33f71a0_0;
    %cmpi/e 8, 0, 4;
    %jmp/0xz  T_3.0, 6;
    %vpi_call/w 3 40 "$display", "PASS: LFSR reset to seed value (1000)" {0 0 0};
    %load/vec4 v0x55e1b33f72b0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55e1b33f72b0_0, 0, 32;
    %jmp T_3.1;
T_3.0 ;
    %vpi_call/w 3 43 "$display", "FAIL: LFSR not reset (lfsr_out=%b)", v0x55e1b33f71a0_0 {0 0 0};
    %load/vec4 v0x55e1b33f7010_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55e1b33f7010_0, 0, 32;
T_3.1 ;
    %vpi_call/w 3 48 "$display", "\012Test 2: Enable and First Shift" {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55e1b33f7370_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55e1b33f6f40_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x55e1b33f71a0_0;
    %cmpi/e 12, 0, 4;
    %jmp/0xz  T_3.2, 6;
    %vpi_call/w 3 54 "$display", "PASS: LFSR shifted correctly" {0 0 0};
    %load/vec4 v0x55e1b33f72b0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55e1b33f72b0_0, 0, 32;
    %jmp T_3.3;
T_3.2 ;
    %vpi_call/w 3 57 "$display", "FAIL: LFSR shift incorrect (lfsr_out=%b, expected=1100)", v0x55e1b33f71a0_0 {0 0 0};
    %load/vec4 v0x55e1b33f7010_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55e1b33f7010_0, 0, 32;
T_3.3 ;
    %vpi_call/w 3 62 "$display", "\012Test 3: Sequence Generation (15 shifts)" {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x55e1b33f70e0_0, 0, 32;
T_3.4 ;
    %load/vec4 v0x55e1b33f70e0_0;
    %cmpi/s 14, 0, 32;
    %jmp/0xz T_3.5, 5;
    %delay 10, 0;
    %load/vec4 v0x55e1b33f71a0_0;
    %cmpi/e 0, 0, 4;
    %jmp/0xz  T_3.6, 6;
    %load/vec4 v0x55e1b33f70e0_0;
    %addi 2, 0, 32;
    %vpi_call/w 3 66 "$display", "FAIL: LFSR locked at 0000 at iteration %0d", S<0,vec4,s32> {1 0 0};
    %load/vec4 v0x55e1b33f7010_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55e1b33f7010_0, 0, 32;
T_3.6 ;
    %load/vec4 v0x55e1b33f70e0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55e1b33f70e0_0, 0, 32;
    %jmp T_3.4;
T_3.5 ;
    %load/vec4 v0x55e1b33f71a0_0;
    %cmpi/ne 0, 0, 4;
    %jmp/0xz  T_3.8, 6;
    %vpi_call/w 3 71 "$display", "PASS: LFSR generated sequence without locking" {0 0 0};
    %load/vec4 v0x55e1b33f72b0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55e1b33f72b0_0, 0, 32;
T_3.8 ;
    %vpi_call/w 3 76 "$display", "\012Test 4: Sequence Periodicity" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55e1b33f7370_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55e1b33f7370_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x55e1b33f70e0_0, 0, 32;
T_3.10 ;
    %load/vec4 v0x55e1b33f70e0_0;
    %cmpi/s 15, 0, 32;
    %jmp/0xz T_3.11, 5;
    %delay 10, 0;
    %load/vec4 v0x55e1b33f70e0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55e1b33f70e0_0, 0, 32;
    %jmp T_3.10;
T_3.11 ;
    %load/vec4 v0x55e1b33f71a0_0;
    %cmpi/e 12, 0, 4;
    %jmp/0xz  T_3.12, 6;
    %vpi_call/w 3 84 "$display", "PASS: LFSR sequence repeated after 15 cycles" {0 0 0};
    %load/vec4 v0x55e1b33f72b0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55e1b33f72b0_0, 0, 32;
    %jmp T_3.13;
T_3.12 ;
    %vpi_call/w 3 87 "$display", "FAIL: LFSR sequence did not repeat (lfsr_out=%b)", v0x55e1b33f71a0_0 {0 0 0};
    %load/vec4 v0x55e1b33f7010_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55e1b33f7010_0, 0, 32;
T_3.13 ;
    %vpi_call/w 3 92 "$display", "\012Test 5: Disable Functionality" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55e1b33f6f40_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x55e1b33f71a0_0;
    %cmpi/e 12, 0, 4;
    %jmp/0xz  T_3.14, 6;
    %vpi_call/w 3 96 "$display", "PASS: LFSR held when disabled" {0 0 0};
    %load/vec4 v0x55e1b33f72b0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55e1b33f72b0_0, 0, 32;
    %jmp T_3.15;
T_3.14 ;
    %vpi_call/w 3 99 "$display", "FAIL: LFSR changed when disabled (lfsr_out=%b)", v0x55e1b33f71a0_0 {0 0 0};
    %load/vec4 v0x55e1b33f7010_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55e1b33f7010_0, 0, 32;
T_3.15 ;
    %vpi_call/w 3 104 "$display", "\012========================================" {0 0 0};
    %vpi_call/w 3 105 "$display", "Test Summary" {0 0 0};
    %vpi_call/w 3 106 "$display", "========================================" {0 0 0};
    %vpi_call/w 3 107 "$display", "Passed: %0d", v0x55e1b33f72b0_0 {0 0 0};
    %vpi_call/w 3 108 "$display", "Failed: %0d", v0x55e1b33f7010_0 {0 0 0};
    %load/vec4 v0x55e1b33f72b0_0;
    %load/vec4 v0x55e1b33f7010_0;
    %add;
    %vpi_call/w 3 109 "$display", "Total:  %0d", S<0,vec4,s32> {1 0 0};
    %vpi_call/w 3 110 "$display", "========================================" {0 0 0};
    %vpi_call/w 3 112 "$finish" {0 0 0};
    %end;
    .thread T_3;
    .scope S_0x55e1b33cc160;
T_4 ;
    %vpi_call/w 3 117 "$monitor", "Time=%0t reset_n=%b en=%b lfsr_out=%b", $time, v0x55e1b33f7370_0, v0x55e1b33f6f40_0, v0x55e1b33f71a0_0 {0 0 0};
    %end;
    .thread T_4;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb_lfsr_4bit_golden.v";
    "lfsr_4bit.v";
