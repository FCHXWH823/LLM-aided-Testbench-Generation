#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x55d98b2477b0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x55d98b2519f0 .scope module, "tb_counter_3bit_golden" "tb_counter_3bit_golden" 3 4;
 .timescale 0 0;
v0x55d98b277f70_0 .var "clk", 0 0;
v0x55d98b278030_0 .net "count", 2 0, v0x55d98b277c50_0;  1 drivers
v0x55d98b278100_0 .var "en", 0 0;
v0x55d98b278200_0 .var/i "failed", 31 0;
v0x55d98b2782a0_0 .var/i "passed", 31 0;
v0x55d98b2783b0_0 .var "reset_n", 0 0;
S_0x55d98b251b80 .scope module, "dut" "counter_3bit" 3 15, 4 1 0, S_0x55d98b2519f0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset_n";
    .port_info 2 /INPUT 1 "en";
    .port_info 3 /OUTPUT 3 "count";
v0x55d98b251da0_0 .net "clk", 0 0, v0x55d98b277f70_0;  1 drivers
v0x55d98b277c50_0 .var "count", 2 0;
v0x55d98b277d30_0 .net "en", 0 0, v0x55d98b278100_0;  1 drivers
v0x55d98b277e00_0 .net "reset_n", 0 0, v0x55d98b2783b0_0;  1 drivers
E_0x55d98b22b640/0 .event negedge, v0x55d98b277e00_0;
E_0x55d98b22b640/1 .event posedge, v0x55d98b251da0_0;
E_0x55d98b22b640 .event/or E_0x55d98b22b640/0, E_0x55d98b22b640/1;
    .scope S_0x55d98b251b80;
T_0 ;
    %wait E_0x55d98b22b640;
    %load/vec4 v0x55d98b277e00_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 3;
    %assign/vec4 v0x55d98b277c50_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x55d98b277d30_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x55d98b277c50_0;
    %addi 1, 0, 3;
    %assign/vec4 v0x55d98b277c50_0, 0;
T_0.2 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x55d98b2519f0;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x55d98b2782a0_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x55d98b278200_0, 0, 32;
    %end;
    .thread T_1, $init;
    .scope S_0x55d98b2519f0;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55d98b277f70_0, 0, 1;
T_2.0 ;
    %delay 5, 0;
    %load/vec4 v0x55d98b277f70_0;
    %inv;
    %store/vec4 v0x55d98b277f70_0, 0, 1;
    %jmp T_2.0;
    %end;
    .thread T_2;
    .scope S_0x55d98b2519f0;
T_3 ;
    %vpi_call/w 3 30 "$display", "========================================" {0 0 0};
    %vpi_call/w 3 31 "$display", "Starting Counter Golden Testbench" {0 0 0};
    %vpi_call/w 3 32 "$display", "========================================" {0 0 0};
    %vpi_call/w 3 35 "$display", "\012Test 1: Reset Functionality" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55d98b2783b0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55d98b278100_0, 0, 1;
    %delay 20, 0;
    %load/vec4 v0x55d98b278030_0;
    %cmpi/e 0, 0, 3;
    %jmp/0xz  T_3.0, 6;
    %vpi_call/w 3 39 "$display", "PASS: Counter reset to 0" {0 0 0};
    %load/vec4 v0x55d98b2782a0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55d98b2782a0_0, 0, 32;
    %jmp T_3.1;
T_3.0 ;
    %vpi_call/w 3 42 "$display", "FAIL: Counter not reset (count=%b)", v0x55d98b278030_0 {0 0 0};
    %load/vec4 v0x55d98b278200_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55d98b278200_0, 0, 32;
T_3.1 ;
    %vpi_call/w 3 47 "$display", "\012Test 2: Enable and Counting" {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55d98b2783b0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55d98b278100_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x55d98b278030_0;
    %cmpi/e 1, 0, 3;
    %jmp/0xz  T_3.2, 6;
    %vpi_call/w 3 51 "$display", "PASS: Counter incremented to 1" {0 0 0};
    %load/vec4 v0x55d98b2782a0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55d98b2782a0_0, 0, 32;
    %jmp T_3.3;
T_3.2 ;
    %vpi_call/w 3 54 "$display", "FAIL: Counter not incremented (count=%b)", v0x55d98b278030_0 {0 0 0};
    %load/vec4 v0x55d98b278200_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55d98b278200_0, 0, 32;
T_3.3 ;
    %vpi_call/w 3 59 "$display", "\012Test 3: Multiple Increments" {0 0 0};
    %pushi/vec4 6, 0, 32;
T_3.4 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_3.5, 5;
    %jmp/1 T_3.5, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %delay 10, 0;
    %jmp T_3.4;
T_3.5 ;
    %pop/vec4 1;
    %load/vec4 v0x55d98b278030_0;
    %cmpi/e 7, 0, 3;
    %jmp/0xz  T_3.6, 6;
    %vpi_call/w 3 62 "$display", "PASS: Counter reached 7" {0 0 0};
    %load/vec4 v0x55d98b2782a0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55d98b2782a0_0, 0, 32;
    %jmp T_3.7;
T_3.6 ;
    %vpi_call/w 3 65 "$display", "FAIL: Counter incorrect (count=%b, expected=111)", v0x55d98b278030_0 {0 0 0};
    %load/vec4 v0x55d98b278200_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55d98b278200_0, 0, 32;
T_3.7 ;
    %vpi_call/w 3 70 "$display", "\012Test 4: Wrap-around" {0 0 0};
    %delay 10, 0;
    %load/vec4 v0x55d98b278030_0;
    %cmpi/e 0, 0, 3;
    %jmp/0xz  T_3.8, 6;
    %vpi_call/w 3 73 "$display", "PASS: Counter wrapped to 0" {0 0 0};
    %load/vec4 v0x55d98b2782a0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55d98b2782a0_0, 0, 32;
    %jmp T_3.9;
T_3.8 ;
    %vpi_call/w 3 76 "$display", "FAIL: Counter did not wrap (count=%b)", v0x55d98b278030_0 {0 0 0};
    %load/vec4 v0x55d98b278200_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55d98b278200_0, 0, 32;
T_3.9 ;
    %vpi_call/w 3 81 "$display", "\012Test 5: Disable Functionality" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55d98b278100_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x55d98b278030_0;
    %cmpi/e 0, 0, 3;
    %jmp/0xz  T_3.10, 6;
    %vpi_call/w 3 85 "$display", "PASS: Counter held at 0 when disabled" {0 0 0};
    %load/vec4 v0x55d98b2782a0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55d98b2782a0_0, 0, 32;
    %jmp T_3.11;
T_3.10 ;
    %vpi_call/w 3 88 "$display", "FAIL: Counter changed when disabled (count=%b)", v0x55d98b278030_0 {0 0 0};
    %load/vec4 v0x55d98b278200_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55d98b278200_0, 0, 32;
T_3.11 ;
    %vpi_call/w 3 93 "$display", "\012========================================" {0 0 0};
    %vpi_call/w 3 94 "$display", "Test Summary" {0 0 0};
    %vpi_call/w 3 95 "$display", "========================================" {0 0 0};
    %vpi_call/w 3 96 "$display", "Passed: %0d", v0x55d98b2782a0_0 {0 0 0};
    %vpi_call/w 3 97 "$display", "Failed: %0d", v0x55d98b278200_0 {0 0 0};
    %load/vec4 v0x55d98b2782a0_0;
    %load/vec4 v0x55d98b278200_0;
    %add;
    %vpi_call/w 3 98 "$display", "Total:  %0d", S<0,vec4,s32> {1 0 0};
    %vpi_call/w 3 99 "$display", "========================================" {0 0 0};
    %vpi_call/w 3 101 "$finish" {0 0 0};
    %end;
    .thread T_3;
    .scope S_0x55d98b2519f0;
T_4 ;
    %vpi_call/w 3 106 "$monitor", "Time=%0t reset_n=%b en=%b count=%b", $time, v0x55d98b2783b0_0, v0x55d98b278100_0, v0x55d98b278030_0 {0 0 0};
    %end;
    .thread T_4;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb_counter_3bit_golden.v";
    "counter_3bit.v";
